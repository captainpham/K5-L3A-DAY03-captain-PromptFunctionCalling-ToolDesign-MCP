        "tool_calls": [
          {
            "name": "deduplicate_sources",
            "args": {
              "items": [
                {
                  "url": "https://example.com/a"
                },
                {
                  "url": "https://example.com/b"
                },
                {
                  "url": "https://example.com/a"
                }
              ]
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Route tới tool mới và truyền nguyên danh sách đầu vào gồm cả nguồn trùng."
      },
      "query": "Loại các nguồn trùng URL trong danh sách sau, giữ bản xuất hiện đầu tiên: [{\"url\": \"https://example.com/a\"}, {\"url\": \"https://example.com/b\"}, {\"url\": \"https://example.com/a\"}]"
