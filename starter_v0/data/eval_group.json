        "tool_calls": [
          {
            "name": "social_search",
            "args": {
              "query": "robotics",
              "search_type": "Top",
              "limit": 4
            }
          }
        ]
      },
      "metadata": {
        "what_it_tests": "Phân biệt tweet phổ biến với tweet mới nhất."
      },
      "query": "Tìm 4 tweet phổ biến nhất về robotics."
